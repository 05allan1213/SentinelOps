{
  "name": "sentinelops-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && vite build",
    "lint": "tsc --noEmit --pretty false && tsc --project tsconfig.node.json --noEmit --pretty false && eslint .",
    "preview": "vite preview",
    "test:smoke": "playwright test tests/smoke/current-ui.spec.ts --project=chromium",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.1",
    "axios": "1.19.0",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.10",
    "echarts": "6.1.0",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.0.3",
    "lucide-react": "0.545.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
