FROM golang:1.27.0-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o /app/server main.go

FROM golang:1.27.0-alpine
ENV TZ=Asia/Shanghai
RUN apk add --no-cache docker-cli
WORKDIR /app
COPY --from=builder /app/server ./server
COPY docs/ ./docs/
COPY manifest/config/config.docker.yaml ./manifest/config/config.yaml
COPY manifest/skills/ ./manifest/skills/
RUN sed -i \
      -e 's/environment: "production"/environment: "test"/' \
      -e 's/aliyun_bailian/e2e_double/g' \
      -e 's#https://dashscope.aliyuncs.com/compatible-mode/v1#http://provider-double:8080/v1#g' \
      -e 's#https://dashscope.aliyuncs.com/compatible-api/v1#http://provider-double:8080/v1#g' \
      -e 's/nginx_container: "nginx"/nginx_container: "sentinelops-e2e-nginx-1"/' \
      -e '/^skill:/,/^agent_runtime:/ s/enabled: false/enabled: true/' \
      -e '/^agent_runtime:/,/^observability:/ s/enabled: false/enabled: true/' \
      -e '/^agent_runtime:/,/^observability:/ s/accept_new_runs: false/accept_new_runs: true/' \
      -e '/^agent_runtime:/,/^observability:/ s/l1_writes: false/l1_writes: true/' \
      -e '/^agent_runtime:/,/^observability:/ s/l2_writes: false/l2_writes: true/' \
      manifest/config/config.yaml && \
    mkdir -p ./manifest/upload/knowledge && \
    mkdir -p ./nginx_blocklist && \
    echo "# AI 运维动态 IP 黑名单（由 block_ip 工具自动写入）" > ./nginx_blocklist/blocked_ips.conf
EXPOSE 8001
CMD ["./server", "api"]
