FROM golang:1.27.0-alpine AS builder
WORKDIR /src
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/server main.go

FROM golang:1.27.0-alpine
ENV TZ=Asia/Shanghai
RUN apk add --no-cache docker-cli
WORKDIR /app
COPY --from=builder /app/server ./server
# Docker 镜像显式使用 config.local.yaml 作为完整配置覆盖；Secret 仍通过环境变量解析。
COPY manifest/config/config.docker.yaml ./manifest/config/config.local.yaml
RUN sed -i \
    -e 's#https://mcp.context7.com/mcp#http://context7:3333/mcp#' \
    -e 's#allowed_hosts: \["mcp.context7.com"\]#allowed_hosts: ["context7"]#' \
    -e 's#allowed_ports: \[443\]#allowed_ports: [3333]#' \
    ./manifest/config/config.local.yaml
RUN mkdir -p ./docs ./manifest/upload/knowledge && \
    mkdir -p ./nginx_blocklist && \
    echo "# AI 运维动态 IP 黑名单（由 block_ip 工具自动写入）" > ./nginx_blocklist/blocked_ips.conf
EXPOSE 8001
CMD ["./server", "api"]
